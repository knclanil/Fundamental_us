{
  "source": "stockanalysis",
  "allow_automated_collection": true,
  "contact_user_agent": "MarketResearchPipeline/3.0.4 (contact: knclanil@live.com)",
  "request_delay_seconds": 5,
  "timeout_seconds": 30,
  "max_tickers": 100,
  "universe": "dynamic",
  "collect_statistics": true,
  "collect_financials": true,
  "collect_prices": false,
  "price_provider": "none",
  "price_api_key_env": "PRICE_API_KEY",
  "price_endpoint_template": "",
  "price_format": "json_rows",
  "collect_finviz": true,
  "collect_stockanalysis": false,
  "rotate_tickers": true,
  "finviz_min_metrics": 60,
  "finviz_required_metrics": [
    "Price",
    "Market Cap",
    "Volume"
  ],
  "collection_strategy": "market_cap_priority",
  "market_cap_seed_csv": "config/market_caps.csv",
  "refresh_after_hours": 24,
  "alpha_vantage_enabled": true,
  "alpha_vantage_daily_budget": 20,
  "alpha_vantage_delay_seconds": 1
}
